DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dormitory_loan
SECRET_KEY=change-me-in-production
# 공휴일 자동 동기화: 공공데이터포털(data.go.kr/data/15012690) '한국천문연구원 특일 정보' 활용신청 후 발급받은 서비스키
KASI_SERVICE_KEY=
# 법정공휴일 외 추가 휴무일(MM-DD:이름, 쉼표 구분). 확정 기준: 없음(5/1·12/31은 휴무 아님)
BANK_EXTRA_CLOSURES=

# --- Phase 14 보안 ---
# 운영 서버에서는 production. 그러면 아래 값들이 안전한지 시작 시 검사한다
APP_ENV=development
# 운영: 화면 주소만(쉼표 구분). 예) https://loan.example.or.kr
CORS_ORIGINS=*
# 계좌번호·백업 암호화 키(base64 32바이트). 생성: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 키를 잃으면 암호화된 데이터·백업을 복구할 수 없음 — 별도 보관
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 이벤트 등록·승인 분리(내부통제). 업무 확정 후 true
EVENT_APPROVAL_REQUIRED=false

# --- 백업 ---
BACKUP_DIR=./backups
BACKUP_ENCRYPT=true
BACKUP_KEEP_DAILY_DAYS=35
BACKUP_KEEP_MONTHLY=60
BACKUP_ALERT_HOURS=36

# 증빙자료 첨부(Phase 17) — 파일은 DATA_ENCRYPTION_KEY로 암호화 저장, 이 폴더도 백업 대상
ATTACHMENT_DIR=./attachments
ATTACHMENT_MAX_MB=20
ATTACHMENT_EXTENSIONS=pdf,hwp,hwpx,doc,docx,xls,xlsx,csv,ppt,pptx,jpg,jpeg,png,gif,txt,zip

# 공문 PDF 변환기(LibreOffice) 실행파일 경로. 비우면 자동으로 찾음(PATH, C:\Program Files\LibreOffice\program\soffice.exe 등)
LIBREOFFICE_PATH=
